# Configurações do Workflow Slack AI Chat
# Copie este arquivo para .env e preencha com suas credenciais

# ============================================
# OPENAI CONFIGURATION
# ============================================
# Obtenha sua API key em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Modelo a ser usado (opções: gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4-turbo-preview

# Temperatura (0.0 = mais determinístico, 1.0 = mais criativo)
OPENAI_TEMPERATURE=0.3

# Máximo de tokens na resposta
OPENAI_MAX_TOKENS=2000

# ============================================
# SLACK CONFIGURATION
# ============================================
# Bot User OAuth Token do seu Slack App
# Obtenha em: https://api.slack.com/apps → Seu App → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-...

# ID do canal a ser monitorado
# Pode ser obtido clicando com botão direito no canal → Ver detalhes do canal
SLACK_CHANNEL_ID=C01234567

# ============================================
# WORKFLOW SETTINGS
# ============================================
# Quantidade de mensagens a buscar (1-1000)
SLACK_MESSAGE_LIMIT=200

# Período de análise em dias
SLACK_HISTORY_DAYS=7

# ============================================
# N8N CONFIGURATION (se self-hosted)
# ============================================
# URL base do seu n8n
N8N_HOST=https://seu-n8n.com

# Porta do n8n
N8N_PORT=5678

# Webhook path
N8N_WEBHOOK_PATH=/webhook/slack-ai-chat

# ============================================
# OPTIONAL: ADVANCED SETTINGS
# ============================================
# Cache de mensagens (em minutos, 0 = desabilitado)
CACHE_DURATION=0

# Timeout para requisições do Slack (em segundos)
SLACK_TIMEOUT=30

# Timeout para requisições da OpenAI (em segundos)
OPENAI_TIMEOUT=60

# ============================================
# SECURITY
# ============================================
# Token de autenticação para o webhook (opcional, mas recomendado)
# Gere um token aleatório: openssl rand -hex 32
WEBHOOK_AUTH_TOKEN=

# Whitelist de IPs permitidos (separados por vírgula, deixe vazio para permitir todos)
ALLOWED_IPS=

# ============================================
# MONITORING & LOGGING
# ============================================
# Nível de log (error, warn, info, debug)
LOG_LEVEL=info

# Salvar logs de conversas (true/false)
SAVE_CONVERSATION_LOGS=false

# Diretório para logs
LOG_DIRECTORY=./logs

# ============================================
# NOTES
# ============================================
# 1. NUNCA commite este arquivo com valores reais!
# 2. Mantenha suas credenciais seguras
# 3. Use variáveis de ambiente em produção
# 4. Revogue tokens se suspeitar de comprometimento
